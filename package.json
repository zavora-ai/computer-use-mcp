{
  "name": "@zavora-ai/computer-use-mcp",
  "version": "7.7.0",
  "description": "MCP server + client for cross-platform desktop control (macOS + Windows + Linux) — screenshot, mouse, keyboard, clipboard, app management. Backed by Rust NAPI native module.",
  "author": "James Karanja Maina <james@zavora.ai> (https://zavora.ai)",
  "license": "MIT",
  "homepage": "https://github.com/zavora-ai/computer-use-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zavora-ai/computer-use-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/zavora-ai/computer-use-mcp/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "os": [
    "darwin",
    "win32",
    "linux"
  ],
  "bin": {
    "computer-use-mcp": "dist/launch.js",
    "computer-use-mcp-http": "dist/http.js",
    "computer-use-mcp-console": "dist/run-console-host.js"
  },
  "exports": {
    ".": {
      "import": "./dist/server.js",
      "types": "./dist/server.d.ts"
    },
    "./client": {
      "import": "./dist/client.js",
      "types": "./dist/client.d.ts"
    },
    "./efficiency": {
      "import": "./dist/efficiency.js",
      "types": "./dist/efficiency.d.ts"
    },
    "./server": {
      "import": "./dist/server.js",
      "types": "./dist/server.d.ts"
    },
    "./http": {
      "import": "./dist/http.js",
      "types": "./dist/http.d.ts"
    },
    "./tool-catalog": {
      "import": "./dist/tool-catalog.js",
      "types": "./dist/tool-catalog.d.ts"
    },
    "./registry": {
      "import": "./dist/registry/registry.js",
      "types": "./dist/registry/registry.d.ts"
    },
    "./host-native": {
      "import": "./dist/native.js",
      "types": "./dist/native.d.ts"
    },
    "./task-store": {
      "import": "./dist/task-store.js",
      "types": "./dist/task-store.d.ts"
    },
    "./desktop-broker": {
      "import": "./dist/desktop-broker.js",
      "types": "./dist/desktop-broker.d.ts"
    },
    "./browser": {
      "import": "./dist/browser.js",
      "types": "./dist/browser.d.ts"
    },
    "./runtime": {
      "import": "./dist/runtime.js",
      "types": "./dist/runtime.d.ts"
    },
    "./supervisor": {
      "import": "./dist/supervisor.js",
      "types": "./dist/supervisor.d.ts"
    },
    "./evaluation": {
      "import": "./dist/evaluation.js",
      "types": "./dist/evaluation.d.ts"
    },
    "./mcp-tasks": {
      "import": "./dist/mcp-tasks.js",
      "types": "./dist/mcp-tasks.d.ts"
    },
    "./isolated-worker": {
      "import": "./dist/isolated-worker.js",
      "types": "./dist/isolated-worker.d.ts"
    },
    "./task-client": {
      "import": "./dist/task-client.js",
      "types": "./dist/task-client.d.ts"
    },
    "./session": {
      "types": "./dist/session.d.ts",
      "import": "./dist/session.js"
    },
    "./run-console": {
      "types": "./dist/run-console-host.d.ts",
      "import": "./dist/run-console-host.js"
    }
  },
  "files": [
    "AGENTS.md",
    "LICENSE",
    "mcp-server.toml",
    "README.md",
    "SECURITY.md",
    "docs/ARCHITECTURE.md",
    "docs/EFFICIENCY.md",
    "docs/releases/v7.1.0.md",
    "dist/",
    "computer-use-napi.darwin-arm64.node",
    "computer-use-napi.darwin-x64.node",
    "computer-use-napi.linux-arm64.node",
    "computer-use-napi.linux-x64.node",
    "computer-use-napi.node",
    "computer-use-napi.win32-x64.node",
    "computer-use-napi.win32-arm64.node",
    "scripts/verify-input-attribution.mjs",
    "skills",
    "libexec",
    "docs/STRATEGY.md",
    "workers",
    "docs/releases/v7.2.0.md",
    "docs/releases/v7.3.0.md",
    "docs/releases/v7.4.0.md",
    "docs/releases/v7.5.0.md",
    "docs/releases/v7.6.0.md",
    "docs/releases/v7.6.1.md",
    "docs/releases/v7.7.0.md",
    "docs/assets/architecture.svg",
    "docs/assets/astra-painting.png",
    "docs/assets/blender-console-live.png",
    "docs/assets/deepseek-ledger-run.gif",
    "docs/assets/deepseek-ledger-run.mp4"
  ],
  "scripts": {
    "build:native": "node scripts/build-native.mjs",
    "build:native:win": "node scripts/build-native.mjs",
    "build:native:win:arm64": "node scripts/build-native.mjs --target aarch64-pc-windows-msvc",
    "build:native:linux": "node scripts/build-native.mjs",
    "build:ts": "node scripts/build-ts.mjs",
    "lint": "eslint src",
    "build": "npm run build:native && npm run build:ts",
    "prepare:packages": "node scripts/prepare-platform-packages.mjs",
    "test": "npm run build:ts && node --test test/*.test.mjs",
    "test:input-attribution": "node scripts/verify-input-attribution.mjs",
    "measure:efficiency": "npm run build:ts && node scripts/measure-efficiency.mjs",
    "smoke": "npm run build:ts && node scripts/smoke.mjs",
    "prepublishOnly": "npm run build",
    "server": "tsx src/server.ts",
    "test:strategy": "npm run build:ts && node --test test/strategy*.test.mjs test/runtime.test.mjs test/session-console.test.mjs",
    "test:browser": "npm run build:ts && node scripts/test-browser.mjs",
    "evaluate:strategy": "npm run build:ts && node scripts/evaluate-strategy.mjs",
    "console": "node dist/run-console-host.js",
    "integration:macos": "npm run build:ts && node scripts/integration-status-card.mjs",
    "pack:platforms": "node scripts/pack-platform-packages.mjs",
    "version": "npm run prepare:packages -- --sync-only"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/core": "2.0.0",
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "eslint": "9.39.1",
    "fast-check": "^4.7.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "8.46.0"
  },
  "optionalDependencies": {
    "playwright": "^1.63.0",
    "@zavora-ai/computer-use-mcp-darwin-arm64": "7.7.0",
    "@zavora-ai/computer-use-mcp-darwin-x64": "7.7.0",
    "@zavora-ai/computer-use-mcp-win32-x64": "7.7.0",
    "@zavora-ai/computer-use-mcp-win32-arm64": "7.7.0",
    "@zavora-ai/computer-use-mcp-linux-x64": "7.7.0",
    "@zavora-ai/computer-use-mcp-linux-arm64": "7.7.0",
    "@anthropic-ai/sdk": "^1.3.0"
  }
}
