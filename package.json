{
  "name": "@zavora-ai/computer-use-mcp",
  "version": "7.0.0",
  "description": "MCP server + client for cross-platform desktop control (macOS + Windows + Linux) — screenshot, mouse, keyboard, clipboard, app management. Backed by Rust NAPI native module.",
  "author": "James Karanja Maina <james@zavora.ai> (https://zavora.ai)",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "os": [
    "darwin",
    "win32",
    "linux"
  ],
  "bin": {
    "computer-use-mcp": "dist/server.js",
    "computer-use-onboard": "dist/onboarding/cli.js"
  },
  "exports": {
    ".": {
      "import": "./dist/server.js",
      "types": "./dist/server.d.ts"
    },
    "./client": {
      "import": "./dist/client.js",
      "types": "./dist/client.d.ts"
    },
    "./server": {
      "import": "./dist/server.js",
      "types": "./dist/server.d.ts"
    },
    "./tool-catalog": {
      "import": "./dist/tool-catalog.js",
      "types": "./dist/tool-catalog.d.ts"
    },
    "./registry": {
      "import": "./dist/registry/registry.js",
      "types": "./dist/registry/registry.d.ts"
    },
    "./runtime": {
      "import": "./dist/runtime/index.js",
      "types": "./dist/runtime/index.d.ts"
    },
    "./reliability": {
      "import": "./dist/reliability/index.js",
      "types": "./dist/reliability/index.d.ts"
    },
    "./onboarding": {
      "import": "./dist/onboarding/index.js",
      "types": "./dist/onboarding/index.d.ts"
    },
    "./host-native": {
      "import": "./dist/native.js",
      "types": "./dist/native.d.ts"
    },
    "./release": {
      "import": "./dist/release/index.js",
      "types": "./dist/release/index.d.ts"
    }
  },
  "files": [
    "AGENTS.md",
    "contracts/",
    "LICENSE",
    "README.md",
    "SECURITY.md",
    "dist/entrypoint.d.ts",
    "dist/entrypoint.js",
    "computer-use-napi.darwin-arm64.node",
    "computer-use-napi.darwin-x64.node",
    "computer-use-napi.linux-arm64.node",
    "computer-use-napi.linux-x64.node",
    "computer-use-napi.node",
    "computer-use-napi.win32-x64.node",
    "dist/client.d.ts",
    "dist/client.js",
    "dist/instructions.d.ts",
    "dist/instructions.js",
    "dist/native.d.ts",
    "dist/native.js",
    "dist/output-schemas.d.ts",
    "dist/output-schemas.js",
    "dist/prompts.d.ts",
    "dist/prompts.js",
    "dist/resources.d.ts",
    "dist/resources.js",
    "dist/result.d.ts",
    "dist/result.js",
    "dist/registry/",
    "dist/runtime/",
    "dist/reliability/",
    "dist/control/",
    "dist/onboarding/",
    "dist/release/",
    "dist/policy/",
    "dist/server.d.ts",
    "dist/server.js",
    "dist/session.d.ts",
    "dist/session.js",
    "dist/session/",
    "dist/targeting/",
    "docs/specs/THREAT-MODEL-v8.md",
    "docs/conformance/v8/",
    "examples/v8-direct-sdk.mjs",
    "examples/v8-langgraph.mjs",
    "examples/v8-electron-setup.mjs",
    "examples/v8-tauri-setup.mjs",
    "examples/v8-setup-ui.mjs",
    "scripts/verify-input-attribution.mjs",
    "scripts/certify-background-adapter.mjs",
    "scripts/certify-semantic-adapter.mjs",
    "scripts/generate-v8-conformance.mjs",
    "scripts/run-v8-reliability-lab.mjs",
    "scripts/probes/v8-emergency-chord.mjs",
    "scripts/generate-release-artifacts.mjs",
    "scripts/evaluate-v8-readiness.mjs",
    "release-artifacts.json",
    "packages/computer-use-supervisor/",
    "packages/computer-use-remote/",
    "dist/tool-catalog.d.ts",
    "dist/tool-catalog.js",
    "skills"
  ],
  "scripts": {
    "build:native": "cd native && cargo build --release && cp target/release/libcomputer_use_napi.dylib ../computer-use-napi.darwin-$(uname -m | sed 's/x86_64/x64/' | sed 's/aarch64/arm64/').node && cp target/release/libcomputer_use_napi.dylib ../computer-use-napi.node && codesign --force --sign - ../computer-use-napi.darwin-$(uname -m | sed 's/x86_64/x64/' | sed 's/aarch64/arm64/').node ../computer-use-napi.node",
    "build:native:win": "cd native && cargo build --release && copy target\\release\\computer_use_napi.dll ..\\computer-use-napi.win32-x64.node",
    "build:native:linux": "cd native && cargo build --release && cp target/release/libcomputer_use_napi.so ../computer-use-napi.linux-$(uname -m | sed 's/x86_64/x64/' | sed 's/aarch64/arm64/').node && cp target/release/libcomputer_use_napi.so ../computer-use-napi.node",
    "build:ts": "tsc",
    "build": "npm run build:native && npm run build:ts",
    "prepare:packages": "node scripts/prepare-platform-packages.mjs",
    "test": "npm run build:ts && node --test test/*.test.mjs",
    "test:input-attribution": "node scripts/verify-input-attribution.mjs",
    "certify:background": "npm run build:ts && node scripts/certify-background-adapter.mjs",
    "certify:semantic": "npm run build:ts && node scripts/certify-semantic-adapter.mjs",
    "conformance:v8": "npm run build:ts && node scripts/generate-v8-conformance.mjs",
    "reliability:v8": "npm run build:ts && node scripts/run-v8-reliability-lab.mjs",
    "reliability:emergency-chord": "npm run build && node scripts/run-v8-reliability-lab.mjs --probe-module scripts/probes/v8-emergency-chord.mjs",
    "release:manifest": "npm run build:ts && node scripts/generate-release-artifacts.mjs",
    "readiness:v8": "npm run build:ts && node scripts/evaluate-v8-readiness.mjs --report-only",
    "readiness:gate": "npm run build:ts && node scripts/evaluate-v8-readiness.mjs",
    "smoke": "npm run build && node scripts/test-v5-smoke.mjs",
    "prepublishOnly": "npm run build",
    "server": "tsx src/server.ts",
    "demo": "tsx examples/demo.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "zod": "^4.0.0"
  },
  "optionalDependencies": {
    "@zavora-ai/computer-use-mcp-darwin-arm64": "7.0.0",
    "@zavora-ai/computer-use-mcp-darwin-x64": "7.0.0",
    "@zavora-ai/computer-use-mcp-win32-x64": "7.0.0",
    "@zavora-ai/computer-use-mcp-linux-x64": "7.0.0",
    "@zavora-ai/computer-use-mcp-linux-arm64": "7.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "fast-check": "^4.7.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
